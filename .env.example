# --------------------------------------------------------------------------- #
# Cronical - example environment file
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
#
#     cp .env.example .env      # macOS / Linux
#     Copy-Item .env.example .env   # Windows PowerShell
#
# Every variable is read by `cronical.config.Settings`, which also accepts
# keyword arguments (highest priority), then process environment variables, then
# this file, then the code defaults.
#
# Nested settings use a double underscore, e.g. CRONICAL_LOG__LEVEL.
# --------------------------------------------------------------------------- #

# --- Application identity -------------------------------------------------- #
CRONICAL_APP_NAME=cronical

# One of: local | dev | ci | prod
CRONICAL_ENVIRONMENT=local

# Extra internal detail in logs. Keep false outside development.
CRONICAL_DEBUG=false

# Repository root. Every path in the project is derived from this.
# Leave unset to use the location auto-detected from the installed package.
# CRONICAL_PROJECT_ROOT=C:/Users/omkar/cronical

# --- Reproducibility ------------------------------------------------------- #
# Seed for estimators, splits and any stochastic explainer.
CRONICAL_RANDOM_SEED=42

# --- Model artefact (no model is trained yet) ------------------------------ #
CRONICAL_MODEL_ARTIFACT_NAME=diabetes_risk_model.joblib

# "untrained" is the honest default for a fresh checkout: it tells the API and
# dashboard to report that no model is available instead of returning a
# placeholder prediction. Change only after a real artifact exists.
CRONICAL_MODEL_VERSION=untrained

# --- Logging --------------------------------------------------------------- #
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
CRONICAL_LOG__LEVEL=INFO

# One of: text | json  (json is one JSON object per line, for CI and log tools)
CRONICAL_LOG__FORMAT=text
CRONICAL_LOG__DATE_FORMAT=%Y-%m-%dT%H:%M:%S%z

# `logging` format string used when CRONICAL_LOG__FORMAT=text.
# CRONICAL_LOG__TEXT_TEMPLATE=%(asctime)s | %(levelname)-8s | %(name)-40s | %(message)s

# Forward records to the interpreter-wide root logger. Leave false to avoid
# duplicated output when a host application configures logging itself.
# CRONICAL_LOG__PROPAGATE=false

# --- FastAPI backend ------------------------------------------------------- #
CRONICAL_API_HOST=127.0.0.1
CRONICAL_API_PORT=8000
CRONICAL_API_RELOAD=true

# --- Streamlit dashboard --------------------------------------------------- #
CRONICAL_STREAMLIT_PORT=8501

# --- Notes on secrets ------------------------------------------------------ #
# This project currently stores no credentials. If a future integration needs
# one (an LLM API key, a hosted model registry, a database), add it here as a
# new CRONICAL_* variable, reference it via pydantic-settings, and add it to
# `Settings.SENSITIVE_FIELDS` so it is redacted from `Settings.describe()`.
